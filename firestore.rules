rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // genRoomId(): 6 chars from A–Z (no I,O) + 2–9 — not decimal digits only.
    function validRoomCode(rid) {
      return rid.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ─── Room document shape helpers ─────────────────────────────────────

    function slotsInRange(slots) {
      return slots is list && slots.size() >= 1 && slots.size() <= 4;
    }

    function idsInRange(ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 4;
    }

    function slotIdsMatchPlayerIds(slots, ids) {
      return slots.size() == ids.size();
    }

    // Prefix: first n entries of two slot lists are identical (join append).
    function slotPrefixEqual(a, b, n) {
      return (n < 1 || a[0] == b[0])
        && (n < 2 || a[1] == b[1])
        && (n < 3 || a[2] == b[2])
        && (n < 4 || a[3] == b[3]);
    }

    function sameSlotIds(bslots, aslots, n) {
      return (n < 1 || bslots[0].id == aslots[0].id)
        && (n < 2 || bslots[1].id == aslots[1].id)
        && (n < 3 || bslots[2].id == aslots[2].id)
        && (n < 4 || bslots[3].id == aslots[3].id);
    }

    // Lobby: only own slot row may change when length unchanged.
    function eachSlotSameOrSelf(bslots, aslots, n) {
      return (n < 1 || aslots[0] == bslots[0] || bslots[0].id == uid())
        && (n < 2 || aslots[1] == bslots[1] || bslots[1].id == uid())
        && (n < 3 || aslots[2] == bslots[2] || bslots[2].id == uid())
        && (n < 4 || aslots[3] == bslots[3] || bslots[3].id == uid());
    }

    function lobbyJoinSlotsValid(before, after) {
      let bslots = before.playerSlots;
      let aslots = after.playerSlots;
      let n = bslots.size();
      return slotsInRange(aslots)
        && idsInRange(after.playerIds)
        && aslots.size() == n + 1
        && after.playerIds.size() == before.playerIds.size() + 1
        && uid() in after.playerIds
        && !(uid() in before.playerIds)
        && aslots[n].id == uid()
        && slotPrefixEqual(bslots, aslots, n);
    }

    function lobbySelfSlotEditValid(before, after) {
      let bslots = before.playerSlots;
      let aslots = after.playerSlots;
      let n = bslots.size();
      return slotsInRange(aslots)
        && aslots.size() == n
        && sameSlotIds(bslots, aslots, n)
        && eachSlotSameOrSelf(bslots, aslots, n);
    }

    function lobbyImmutableCore(before, after) {
      return after.gameState == before.gameState
        && after.status == before.status
        && after.hostId == before.hostId;
    }

    // Turn = Firestore state before this write (prevents claiming another seat).
    function currentActorId(room) {
      return room.gameState.players[room.gameState.currentPlayerIdx].id;
    }

    function isActorTurn(room) {
      return room.gameState is map
        && room.gameState.players is list
        && room.gameState.players.size() >= 1
        && room.gameState.currentPlayerIdx is int
        && room.gameState.currentPlayerIdx >= 0
        && room.gameState.currentPlayerIdx < room.gameState.players.size()
        && currentActorId(room) == uid();
    }

    function goalLandingConfirmerIdx(gs) {
      return (gs.players.size() > 0 && gs.players[0].id == uid() && gs.players[0].movePhase == 'goalLanding')
        ? 0
        : (gs.players.size() > 1 && gs.players[1].id == uid() && gs.players[1].movePhase == 'goalLanding')
        ? 1
        : (gs.players.size() > 2 && gs.players[2].id == uid() && gs.players[2].movePhase == 'goalLanding')
        ? 2
        : (gs.players.size() > 3 && gs.players[3].id == uid() && gs.players[3].movePhase == 'goalLanding')
        ? 3
        : -1;
    }

    function goalLandingPatchFrozenOk(gs0, gs1, confirmerIdx) {
      let n = gs0.players.size();
      return n == gs1.players.size()
        && (confirmerIdx != 0 || gs1.players[0] == gs0.players[0])
        && (confirmerIdx != 1 || gs1.players[1] == gs0.players[1])
        && (confirmerIdx != 2 || gs1.players[2] == gs0.players[2])
        && (confirmerIdx != 3 || gs1.players[3] == gs0.players[3]);
    }

    function goalLandingConfirmValid(roomBefore, gs1) {
      let gs0 = roomBefore.gameState;
      let confirmerIdx = goalLandingConfirmerIdx(gs0);
      let cp = gs0.currentPlayerIdx;
      let curPhase = gs0.players[cp].movePhase;
      let beforeP = gs0.players[confirmerIdx];
      let afterP = gs1.players[confirmerIdx];
      return gs0 is map
        && gs1 is map
        && gs0.subPhase == 'day8'
        && gs1.subPhase == 'day8'
        && gs1.currentPlayerIdx == gs0.currentPlayerIdx
        && confirmerIdx >= 0
        && cp is int
        && cp >= 0
        && cp < gs0.players.size()
        && (curPhase == 'arrived' || curPhase == 'waitingSlot')
        && beforeP.movePhase == 'goalLanding'
        && (afterP.movePhase == 'waitingSlot' || afterP.movePhase == 'arrived')
        && goalLandingPatchFrozenOk(gs0, gs1, confirmerIdx);
    }

    function isHost(room) {
      return room.hostId == uid();
    }

    function hostFinalBattleWriteAllowed(room, nextGs) {
      return isHost(room)
        && room.gameState is map
        && nextGs is map
        && (
          room.gameState.gamePhase == 'finalBattle'
          || nextGs.gamePhase == 'finalBattle'
        );
    }

    // Ghost "isGhost": alive == false on current actor (matches isGhostPickTargetPhase / proxy slot actor).
    function actorIsGhost(gs) {
      let cp = gs.currentPlayerIdx;
      let ap = gs.players[cp];
      return ap is map && 'alive' in ap && ap.alive == false;
    }

    // Non-actor, non-proxy-target player docs must be byte-identical (controlled proxy: only target money etc. changes).
    function mustFreezeGhostSlot(j, cp, hasPxy, pxy) {
      return j != cp && (!hasPxy || j != pxy);
    }

    function ghostProxyFrozenOk(gs0, gs1) {
      let cp = gs0.currentPlayerIdx;
      let n = gs0.players.size();
      let pxy = gs0.proxySlotTargetIdx;
      let hasPxy = pxy is int;
      return n == gs1.players.size()
        && (n < 1 || !mustFreezeGhostSlot(0, cp, hasPxy, pxy) || gs1.players[0] == gs0.players[0])
        && (n < 2 || !mustFreezeGhostSlot(1, cp, hasPxy, pxy) || gs1.players[1] == gs0.players[1])
        && (n < 3 || !mustFreezeGhostSlot(2, cp, hasPxy, pxy) || gs1.players[2] == gs0.players[2])
        && (n < 4 || !mustFreezeGhostSlot(3, cp, hasPxy, pxy) || gs1.players[3] == gs0.players[3]);
    }

    // 脱落者（ゴースト）の代理スロット終了 → 次プレイヤーへ currentPlayerIdx を進める書き込みを許可
    function ghostTurnHandoffAfterSlotOk(gs0, gs1) {
      let cp = gs0.currentPlayerIdx;
      let n = gs0.players.size();
      let ap0 = gs0.players[cp];
      let ap1g = gs1.players[cp];
      let phase0 = !('slotPhase' in gs0) || gs0.slotPhase == null ? 'idle' : gs0.slotPhase;
      let slotBurnt = !('slotTurnsLeft' in ap0) || ap0.slotTurnsLeft == null || ap0.slotTurnsLeft <= 0;
      let handedOff = ap1g.movePhase == 'spectating' || ap1g.ghostActedThisRound == true;
      return gs0 is map
        && gs1 is map
        && actorIsGhost(gs0)
        && gs1.currentPlayerIdx != cp
        && gs1.players.size() == n
        && cp >= 0
        && cp < n
        && (!('proxySlotTargetIdx' in gs1) || gs1.proxySlotTargetIdx == null)
        && ap0 is map
        && ap1g is map
        && (phase0 == 'idle' || phase0 == 'completed')
        && slotBurnt
        && handedOff;
    }

    function ghostProxyMoneyOkIfGhostActor(roomBefore, gs1) {
      let gs0 = roomBefore.gameState;
      return !(gs0 is map)
        || !actorIsGhost(gs0)
        || ghostTurnHandoffAfterSlotOk(gs0, gs1)
        || ghostProxyFrozenOk(gs0, gs1);
    }

    function dailyCutinFieldsShapeValid(data) {
      return (!('dailyCutinPhase' in data) || data.dailyCutinPhase is string)
        && (!('dailyCutinSessionId' in data)
          || data.dailyCutinSessionId == null
          || data.dailyCutinSessionId is string)
        && (!('dailyCutinPayload' in data)
          || data.dailyCutinPayload == null
          || data.dailyCutinPayload is map);
    }

    // 1〜7日目：カットイン観戦同期（ルーム直下 dailyCutin* のみ・gameState は不変）
    function dailyCutinRoomBroadcastValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return before.status == 'playing'
        && uid() in before.playerIds
        && before.gameState is map
        && before.gameState.subPhase == 'daily'
        && dailyCutinFieldsShapeValid(after)
        && affected.hasOnly(['dailyCutinPhase', 'dailyCutinSessionId', 'dailyCutinPayload'])
        && after.gameState == before.gameState
        && after.status == before.status
        && after.hostId == before.hostId
        && after.playerIds == before.playerIds
        && after.playerSlots == before.playerSlots
        && after.remainingTurns == before.remainingTurns
        && after.completedPlayers == before.completedPlayers;
    }

    function playGameStatePatchValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return (
          affected.hasOnly(['gameState'])
          || affected.hasOnly(['gameState', 'status'])
          || affected.hasOnly(['gameState', 'remainingTurns', 'completedPlayers'])
          || affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers'])
          || affected.hasOnly(['gameState', 'totalPot'])
          || affected.hasOnly(['gameState', 'status', 'totalPot'])
          || affected.hasOnly(['gameState', 'remainingTurns', 'completedPlayers', 'totalPot'])
          || affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers', 'totalPot'])
        )
        && before.gameState != null
        && after.gameState is map
        && after.gameState.players is list
        && slotsInRange(after.gameState.players)
        && after.remainingTurns is int
        && after.remainingTurns >= 0
        && after.completedPlayers is list
        && (!affected.hasAny(['totalPot']) || (after.totalPot is int && after.totalPot >= 0))
        && after.playerSlots == before.playerSlots
        && after.playerIds == before.playerIds
        && after.hostId == before.hostId
        && (
          (isActorTurn(before) && ghostProxyMoneyOkIfGhostActor(before, after.gameState))
          || goalLandingConfirmValid(before, after.gameState)
          || hostFinalBattleWriteAllowed(before, after.gameState)
        );
    }

    function hostStartGameValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return uid() == before.hostId
        && before.status == 'lobby'
        && after.status == 'playing'
        && affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers', 'totalPot'])
        && before.gameState == null
        && after.gameState != null
        && after.totalPot is int
        && after.totalPot >= 15000
        && after.totalPot <= 20000
        && after.remainingTurns is int
        && after.remainingTurns >= 0
        && after.completedPlayers is list
        && after.playerSlots == before.playerSlots
        && after.playerIds == before.playerIds
        && after.hostId == before.hostId;
    }

    function lobbyInviteValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let rosterOk = before.status == 'lobby'
        && lobbyImmutableCore(before, after)
        && uid() in before.playerIds;
      // 招待は allowedPlayers / invitedAuthUids への追加のみ（after が before の超集合）
      let allowedGrowOnly = after.allowedPlayers is list
        && (
          !('allowedPlayers' in before)
          || (before.allowedPlayers is list && after.allowedPlayers.hasAll(before.allowedPlayers))
        );
      let invitedGrowOnly = !('invitedAuthUids' in after)
        || (
          after.invitedAuthUids is list
          && (
            !('invitedAuthUids' in before)
            || (before.invitedAuthUids is list && after.invitedAuthUids.hasAll(before.invitedAuthUids))
          )
        );
      return rosterOk
        && allowedGrowOnly
        && invitedGrowOnly
        && (
          affected.hasOnly(['allowedPlayers'])
          || affected.hasOnly(['invitedAuthUids'])
          || affected.hasOnly(['allowedPlayers', 'invitedAuthUids'])
        );
    }

    function lobbyCancelInviteValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let hostOk = before.status == 'lobby'
        && uid() == before.hostId
        && lobbyImmutableCore(before, after);
      let allowedShrink = after.allowedPlayers is list
        && before.allowedPlayers is list
        && before.allowedPlayers.hasAll(after.allowedPlayers)
        && after.allowedPlayers.size() >= 1;
      let invitedShrink = !('invitedAuthUids' in after) && !('invitedAuthUids' in before)
        || (
          after.invitedAuthUids is list
          && before.invitedAuthUids is list
          && before.invitedAuthUids.hasAll(after.invitedAuthUids)
        );
      return hostOk
        && allowedShrink
        && invitedShrink
        && (
          affected.hasOnly(['allowedPlayers'])
          || affected.hasOnly(['invitedAuthUids'])
          || affected.hasOnly(['allowedPlayers', 'invitedAuthUids'])
        );
    }

    function lobbyJoinValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return before.status == 'lobby'
        && lobbyImmutableCore(before, after)
        && affected.hasOnly(['playerSlots', 'playerIds'])
        && lobbyJoinSlotsValid(before, after);
    }

    function lobbySelfSlotsValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return before.status == 'lobby'
        && lobbyImmutableCore(before, after)
        && affected.hasOnly(['playerSlots'])
        && uid() in before.playerIds
        && lobbySelfSlotEditValid(before, after);
    }

    function hostContinueToLobbyValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let n = before.playerSlots.size();
      return uid() == before.hostId
        && before.status == 'completed'
        && after.status == 'lobby'
        && after.gameState == null
        && after.hostId == before.hostId
        && after.playerIds == before.playerIds
        && after.completedPlayers is list
        && after.completedPlayers.size() == 0
        && after.remainingTurns is int
        && after.remainingTurns >= 0
        && slotsInRange(after.playerSlots)
        && idsInRange(after.playerIds)
        && slotIdsMatchPlayerIds(after.playerSlots, after.playerIds)
        && after.playerSlots.size() == n
        && sameSlotIds(before.playerSlots, after.playerSlots, n)
        && (
          affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers', 'playerSlots'])
          || affected.hasOnly(['status', 'gameState', 'remainingTurns', 'completedPlayers', 'playerSlots'])
        );
    }

    function playerLeaveRoomValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return before.status == 'completed'
        && before.hostId != uid()
        && uid() in before.playerIds
        && !(uid() in after.playerIds)
        && after.hostId == before.hostId
        && after.gameState == before.gameState
        && after.status == before.status
        && after.completedPlayers == before.completedPlayers
        && after.remainingTurns == before.remainingTurns
        && affected.hasOnly(['playerSlots', 'playerIds'])
        && after.playerIds.size() == before.playerIds.size() - 1
        && after.playerSlots.size() == before.playerSlots.size() - 1
        && slotsInRange(after.playerSlots)
        && idsInRange(after.playerIds)
        && slotIdsMatchPlayerIds(after.playerSlots, after.playerIds);
    }

    function actorIsNetworkAutomated(gs) {
      let cp = gs.currentPlayerIdx;
      let ap = gs.players[cp];
      return cp is int
        && cp >= 0
        && cp < gs.players.size()
        && ap is map
        && (ap.isGhost == true || ap.isGameOver == true || ap.alive == false);
    }

    function networkGhostMarkPlayerPair(beforeP, afterP) {
      return afterP == beforeP
        || (
          beforeP.isGhost != true
          && afterP.isGhost == true
          && afterP.diff(beforeP).affectedKeys().hasOnly(['isGhost'])
        );
    }

    function networkGhostMarkPlayersOk(gs0, gs1) {
      let n = gs0.players.size();
      return n == gs1.players.size()
        && (n < 1 || networkGhostMarkPlayerPair(gs0.players[0], gs1.players[0]))
        && (n < 2 || networkGhostMarkPlayerPair(gs0.players[1], gs1.players[1]))
        && (n < 3 || networkGhostMarkPlayerPair(gs0.players[2], gs1.players[2]))
        && (n < 4 || networkGhostMarkPlayerPair(gs0.players[3], gs1.players[3]));
    }

    function presenceSelfPlayerPair(beforeP, afterP) {
      return beforeP.id != uid()
        || afterP.diff(beforeP).affectedKeys().hasOnly(['isGhost', 'isGameOver'])
        || (
          afterP.diff(beforeP).affectedKeys().hasOnly(['isGameOver'])
          && afterP.isGameOver == true
        )
        || (
          afterP.diff(beforeP).affectedKeys().hasOnly(['isGhost'])
          && beforeP.isGhost == true
          && afterP.isGhost == false
          && afterP.isGameOver == beforeP.isGameOver
        );
    }

    function presenceSelfPlayersOk(gs0, gs1) {
      let n = gs0.players.size();
      return n == gs1.players.size()
        && (n < 1 || presenceSelfPlayerPair(gs0.players[0], gs1.players[0]))
        && (n < 2 || presenceSelfPlayerPair(gs0.players[1], gs1.players[1]))
        && (n < 3 || presenceSelfPlayerPair(gs0.players[2], gs1.players[2]))
        && (n < 4 || presenceSelfPlayerPair(gs0.players[3], gs1.players[3]));
    }

    function presenceGhostMarkValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return (before.status == 'playing' || before.status == 'FINAL_BATTLE')
        && uid() in before.playerIds
        && before.gameState is map
        && after.gameState is map
        && affected.hasOnly(['gameState'])
        && before.gameState.diff(after.gameState).affectedKeys().hasOnly(['players'])
        && networkGhostMarkPlayersOk(before.gameState, after.gameState)
        && after.playerSlots == before.playerSlots
        && after.playerIds == before.playerIds
        && after.hostId == before.hostId;
    }

    function presenceSelfPatchValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      return (before.status == 'playing' || before.status == 'FINAL_BATTLE')
        && uid() in before.playerIds
        && before.gameState is map
        && after.gameState is map
        && affected.hasOnly(['gameState'])
        && before.gameState.diff(after.gameState).affectedKeys().hasOnly(['players'])
        && presenceSelfPlayersOk(before.gameState, after.gameState)
        && after.playerSlots == before.playerSlots
        && after.playerIds == before.playerIds
        && after.hostId == before.hostId;
    }

    function ghostAutomationLeaseValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let lease = after.ghostAutomationLease;
      return (before.status == 'playing' || before.status == 'FINAL_BATTLE')
        && uid() in before.playerIds
        && affected.hasOnly(['ghostAutomationLease'])
        && lease is map
        && lease.keys().hasOnly(['holderId', 'expiresAt'])
        && lease.holderId == uid()
        && lease.expiresAt is number
        && lease.expiresAt >= request.time.toMillis()
        && lease.expiresAt <= request.time.toMillis() + 30000;
    }

    function ghostAutomationTurnValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let gs0 = before.gameState;
      let gs1 = after.gameState;
      return (before.status == 'playing' || before.status == 'FINAL_BATTLE')
        && gs0 is map
        && gs1 is map
        && actorIsNetworkAutomated(gs0)
        && uid() in before.playerIds
        && gs0.players[gs0.currentPlayerIdx].id != uid()
        && (
          affected.hasOnly(['gameState'])
          || affected.hasOnly(['gameState', 'status'])
          || affected.hasOnly(['gameState', 'remainingTurns', 'completedPlayers'])
          || affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers'])
          || affected.hasOnly(['gameState', 'totalPot'])
          || affected.hasOnly(['gameState', 'status', 'totalPot'])
          || affected.hasOnly(['gameState', 'remainingTurns', 'completedPlayers', 'totalPot'])
          || affected.hasOnly(['gameState', 'status', 'remainingTurns', 'completedPlayers', 'totalPot'])
        )
        && gs1.players is list
        && slotsInRange(gs1.players)
        && after.remainingTurns is int
        && after.remainingTurns >= 0
        && after.completedPlayers is list
        && (!affected.hasAny(['totalPot']) || (after.totalPot is int && after.totalPot >= 0))
        && after.playerSlots == before.playerSlots
        && after.playerIds == before.playerIds
        && after.hostId == before.hostId
        && ghostProxyMoneyOkIfGhostActor(before, gs1);
    }

    function hostKickFromLobbyValid() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let rosterOk = before.status == 'lobby'
        && uid() == before.hostId
        && lobbyImmutableCore(before, after)
        && after.playerIds.size() == before.playerIds.size() - 1
        && after.playerSlots.size() == before.playerSlots.size() - 1
        && before.hostId in after.playerIds
        && before.playerIds.hasAll(after.playerIds)
        && slotsInRange(after.playerSlots)
        && idsInRange(after.playerIds)
        && slotIdsMatchPlayerIds(after.playerSlots, after.playerIds);
      return rosterOk
        && (
          affected.hasOnly(['playerSlots', 'playerIds'])
          || (
            affected.hasOnly(['playerSlots', 'playerIds', 'allowedPlayers'])
            && after.allowedPlayers is list
            && before.allowedPlayers.hasAll(after.allowedPlayers)
          )
          || (
            affected.hasOnly(['playerSlots', 'playerIds', 'allowedPlayers', 'invitedAuthUids'])
            && after.allowedPlayers is list
            && before.allowedPlayers.hasAll(after.allowedPlayers)
            && after.invitedAuthUids is list
            && before.invitedAuthUids.hasAll(after.invitedAuthUids)
          )
          || (
            affected.hasOnly(['playerSlots', 'playerIds', 'invitedAuthUids'])
            && after.invitedAuthUids is list
            && before.invitedAuthUids.hasAll(after.invitedAuthUids)
          )
        );
    }

    function createRoomValid(rid) {
      let d = request.resource.data;
      return signedIn()
        && validRoomCode(rid)
        && d.hostId == uid()
        && d.status == 'lobby'
        && idsInRange(d.playerIds)
        && uid() in d.playerIds
        && slotsInRange(d.playerSlots)
        && slotIdsMatchPlayerIds(d.playerSlots, d.playerIds)
        && (d.gameState == null);
    }

    function inviteInboxPayloadValid() {
      return request.resource.data.keys().hasOnly(['roomIds', 'updatedAt'])
        && request.resource.data.roomIds is list
        && request.resource.data.roomIds.size() <= 30;
    }

    // ゲストの招待受信箱（list クエリ不要・自分の UID ドキュメントのみ read）
    match /inviteInbox/{inviteeUid} {
      allow read: if signedIn() && inviteeUid == uid();
      allow create: if signedIn() && inviteInboxPayloadValid();
      allow update: if signedIn()
        && inviteInboxPayloadValid()
        && (
          request.resource.data.roomIds.hasAll(resource.data.roomIds)
          || (
            inviteeUid == uid()
            && resource.data.roomIds is list
            && resource.data.roomIds.hasAll(request.resource.data.roomIds)
          )
          || (
            inviteeUid != uid()
            && resource.data.roomIds is list
            && resource.data.roomIds.hasAll(request.resource.data.roomIds)
          )
        );
      allow delete: if false;
    }

    // Name#1234 → Auth UID（招待通知のルックアップ用）
    match /fullIdIndex/{fullId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt']);
      allow delete: if false;
    }

    match /rooms/{roomId} {

      // Single-room fetch by code (join / spectate) — no account required.
      allow get: if validRoomCode(roomId);

      // 招待一覧: invitedAuthUids に自分の Auth UID が含まれる待機ルームのみ（secure query）
      allow list: if signedIn()
        && validRoomCode(roomId)
        && resource.data.status == 'lobby'
        && resource.data.invitedAuthUids is list
        && resource.data.invitedAuthUids.hasAny([uid()])
        && request.query.limit <= 20;

      allow create: if createRoomValid(roomId);

      allow update: if signedIn()
        && validRoomCode(roomId)
        && idsInRange(request.resource.data.playerIds)
        && slotsInRange(request.resource.data.playerSlots)
        && slotIdsMatchPlayerIds(request.resource.data.playerSlots, request.resource.data.playerIds)
        && (
          lobbyJoinValid()
          || (
            uid() in resource.data.playerIds
            && (
              lobbyInviteValid()
              || lobbyCancelInviteValid()
              || lobbySelfSlotsValid()
              || hostStartGameValid()
              || playGameStatePatchValid()
              || hostContinueToLobbyValid()
              || playerLeaveRoomValid()
              || hostKickFromLobbyValid()
              || presenceGhostMarkValid()
              || presenceSelfPatchValid()
              || ghostAutomationLeaseValid()
              || ghostAutomationTurnValid()
              || dailyCutinRoomBroadcastValid()
            )
          )
        );

      allow delete: if signedIn()
        && resource.data.hostId == uid();

      match /players/{playerId} {
        allow read: if validRoomCode(roomId)
          && signedIn()
          && uid() in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerIds;

        allow create, update: if validRoomCode(roomId)
          && signedIn()
          && playerId == uid()
          && uid() in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerIds
          && request.resource.data.uid == uid()
          && request.resource.data.keys().hasOnly(['uid', 'currentAction', 'updatedAt'])
          && request.resource.data.currentAction is map
          && request.resource.data.currentAction.keys().hasOnly(['type', 'timestamp']);

        allow delete: if validRoomCode(roomId)
          && signedIn()
          && playerId == uid();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
